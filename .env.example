# ============================================================
#  CLAUDE (principal)  ->  pega tu clave aquí cuando la compres
#  https://console.anthropic.com/settings/keys
#  Con esta línea llena, la app usa Claude automáticamente.
# ============================================================
ANTHROPIC_API_KEY=

# Modelos de Claude (opcional cambiarlos)
CLAUDE_MODELO=claude-opus-5-5
CLAUDE_MODELO_RAPIDO=claude-haiku-5-5

# ============================================================
#  GROQ (gratis, respaldo) -> se usa solo si ANTHROPIC_API_KEY está vacía
# ============================================================
GROQ_API_KEY=gsk_...
# LLM_MODELO=openai/gpt-oss-120b
# LLM_MODELO_RESPALDO=openai/gpt-oss-20b
